APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visualkit?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
MIGRATIONS_DIR=migrations

S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_URL_TTL=15m
S3_DOWNLOAD_URL_TTL=15m
S3_MAX_ASSET_BYTES=26214400
S3_VERIFY_OBJECT_ON_COMPLETE=true
SQS_QUEUE_URL=
SQS_REGION=
WORKER_CONCURRENCY=4
WORKER_LONG_POLL_WAIT=20s
WORKER_VISIBILITY_TIMEOUT=5m
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_PROVIDER_TIMEOUT=2m
WORKER_MAX_ATTEMPTS=3

VISION_PROVIDER=mock
VISION_ENDPOINT=
VISION_API_KEY=
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
GENERATION_CREDIT_COST=80

# Authentication:
# - development accepts X-User-ID for local testing and otherwise uses DEVELOPMENT_USER_ID.
# - bearer requires an AuthProvider with a token verifier to be injected by the API entrypoint.
AUTH_MODE=development
DEVELOPMENT_USER_ID=
INTERNAL_JOB_TOKEN=
