{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadUserReferenceImages",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::visualkit-staging-assets/users/*/assets/*/original"
    },
    {
      "Sid": "ReadUserImages",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::visualkit-staging-assets/users/*/assets/*/original",
        "arn:aws:s3:::visualkit-staging-assets/users/*/creations/*"
      ]
    }
  ]
}
